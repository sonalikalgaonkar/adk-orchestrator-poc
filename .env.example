# Model switch: "anthropic/<model>" goes through LiteLLM; a plain Gemini name goes direct.
# Claude example: MODEL=anthropic/claude-sonnet-5-5  ROUTER_MODEL=anthropic/claude-haiku-5-5  (needs an sk-ant-api03 key)
MODEL=gemini-3.7-flash
ROUTER_MODEL=gemini-3.7-flash
ANTHROPIC_API_KEY=

# Gemini via Vertex AI (uses your gcloud login, no key needed)
GOOGLE_GENAI_USE_VERTEXAI=True
GOOGLE_CLOUD_PROJECT=your-project
GOOGLE_CLOUD_LOCATION=global
